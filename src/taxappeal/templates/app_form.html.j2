<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tax Appeal Builder</title>
<style>{% include "app.css" %}</style>
</head>
<body>
<header><div class="inner"><a href="/">Tax Appeal Builder</a><small>Miami-Dade VAB</small></div></header>
<main>
  <h1>Build your appeal packet</h1>
  <p class="muted">Enter your property and we'll check whether an appeal is worth it, then build the evidence packet and a step-by-step guide.</p>
  {% if mock_mode %}<div class="mock"><strong>Mock data:</strong> only the 4 fictional properties listed are available. Start the server with <code>TAXAPPEAL_CONNECTORS=property_records=dor,sales=dor</code> to use the state roll.</div>{% endif %}
  {% if error %}<p class="error">{{ error }}</p>{% endif %}

  <form method="post" action="/generate" enctype="multipart/form-data">
    <input type="hidden" name="tax_year" value="{{ v('tax_year', '2026') }}">
    <input type="hidden" name="trim_folio" value="{{ v('trim_folio') }}">
    <section class="card">
      <h2>1. Your property</h2>
      <label for="folio">Folio number</label>
      <input id="folio" name="folio" type="text" required list="folio-list" placeholder="e.g. 30-4019-001-0100" value="{{ v('folio') }}" autocomplete="off">
      <datalist id="folio-list">
        {% for folio, address in folios %}<option value="{{ folio }}">{{ address }}</option>{% endfor %}
      </datalist>
      <p class="muted" style="font-size:13px;margin:6px 0 0">Your folio number is on your TRIM notice ("Notice of Proposed Property Taxes") and on the Property Appraiser's website.</p>
    </section>

    <section class="card" id="trim">
      <h2>2. Your TRIM notice</h2>
      <p class="muted" style="font-size:13px;margin-top:0">Upload a PDF or photo and we'll read the values for you, or type them in.{% if not trim_required %} (Optional with mock data.){% endif %}</p>
      <div class="upload">
        <input type="file" name="trim_file" id="trim_file" accept="application/pdf,image/*" aria-label="TRIM notice file">
        <button type="submit" class="secondary" id="read_notice" formaction="/extract#trim" formnovalidate>Read my notice</button>
        <span id="reading" class="muted" role="status" hidden>Reading your notice… photos can take a minute.</span>
      </div>
      {% if not photo_ocr %}<p class="muted" style="font-size:12px;margin:6px 0 0">PDFs downloaded from the Property Appraiser are read directly. To read photos or scanned PDFs, install the OCR model: <code>pip install -e '.[local-ocr]'</code></p>{% endif %}
      {% if ocr_error %}<p class="error" style="margin-top:12px">{{ ocr_error }}</p>{% endif %}
      {% if notice %}<p class="mock" style="margin-top:12px">{{ notice }}</p>{% endif %}
      {% if ocr_notes %}<ul class="muted" style="font-size:13px">{% for n in ocr_notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
      <div class="grid" style="margin-top:14px">
        <div><label for="trim_just_value">Market (just) value, this year</label><input id="trim_just_value" name="trim_just_value" type="text" inputmode="numeric" value="{{ v('trim_just_value') }}"></div>
        <div><label for="trim_assessed_value">Assessed value, this year</label><input id="trim_assessed_value" name="trim_assessed_value" type="text" inputmode="numeric" value="{{ v('trim_assessed_value') }}"></div>
        <div><label for="trim_taxable_value">Taxable value, this year</label><input id="trim_taxable_value" name="trim_taxable_value" type="text" inputmode="numeric" value="{{ v('trim_taxable_value') }}"></div>
        <div><label for="trim_prior_assessed_value">Assessed value, last year</label><input id="trim_prior_assessed_value" name="trim_prior_assessed_value" type="text" inputmode="numeric" value="{{ v('trim_prior_assessed_value') }}"></div>
        <div><label for="trim_total_millage">Total proposed millage</label><input id="trim_total_millage" name="trim_total_millage" type="text" inputmode="decimal" placeholder="e.g. 18.9" value="{{ v('trim_total_millage') }}"></div>
        <div><label for="trim_mailing_date">Date mailed</label><input id="trim_mailing_date" name="trim_mailing_date" type="date" value="{{ v('trim_mailing_date') }}"></div>
        <div><label for="trim_petition_deadline">Petition deadline on the notice</label><input id="trim_petition_deadline" name="trim_petition_deadline" type="date" value="{{ v('trim_petition_deadline') }}"></div>
      </div>
    </section>

    <section class="card">
      <h2>3. About you</h2>
      <div class="grid">
        <div><label for="owner_name">Owner name</label><input id="owner_name" name="owner_name" type="text" required value="{{ v('owner_name') }}"></div>
        <div><label for="email">Email</label><input id="email" name="email" type="email" value="{{ v('email') }}"></div>
        <div class="full"><label for="mailing_address">Mailing address</label><input id="mailing_address" name="mailing_address" type="text" required value="{{ v('mailing_address') }}"></div>
        <div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" value="{{ v('phone') }}"></div>
      </div>
    </section>

    <section class="card">
      <h2>4. Where you are in the process</h2>
      <div class="grid">
        <label class="check full"><input type="checkbox" name="petition_filed" id="petition_filed" {{ "checked" if checked("petition_filed") }}> I've already filed my petition with the Value Adjustment Board</label>
        <div><label for="hearing_date">Hearing date (if scheduled)</label><input id="hearing_date" name="hearing_date" type="date" value="{{ v('hearing_date') }}"></div>
      </div>
    </section>

    <section class="card">
      <h2>5. Condition problems (optional)</h2>
      <p class="muted" style="font-size:13px;margin-top:0">Repairs the home needed on January 1, such as a failing roof or plumbing. Contractor estimates make the strongest evidence.</p>
      <div id="repairs">
        {% for desc, amount, source in repairs or [("", "", "")] %}
        <div class="repair">
          <input type="text" name="repair_description" placeholder="What needs repair" value="{{ desc }}" aria-label="Repair description">
          <input type="text" name="repair_amount" inputmode="numeric" placeholder="Cost ($)" value="{{ amount }}" aria-label="Repair cost">
          <input type="text" name="repair_source" placeholder="Contractor (or owner estimate)" value="{{ source }}" aria-label="Estimate source">
          <button type="button" class="link" onclick="removeRepair(this)" aria-label="Remove">✕</button>
        </div>
        {% endfor %}
      </div>
      <button type="button" class="secondary" onclick="addRepair()">+ Add repair</button>
      <label class="check" style="margin-top:14px"><input type="checkbox" name="recent_improvements" {{ "checked" if checked("recent_improvements") }}> I added or renovated something in the past year (addition, pool, etc.)</label>
    </section>

    <section class="card">
      <label class="check"><input type="checkbox" name="pdf" {{ "checked" if checked("pdf") or not v("folio") }}> Also create printable PDFs (takes a few seconds)</label>
      <div style="margin-top:12px"><button class="primary" type="submit">Build my packet</button></div>
      <p class="muted" style="font-size:12px;margin-bottom:0">Data sources: {% for k, s in sources.items() %}{{ k.replace("_", " ") }}: {{ s }}{{ "; " if not loop.last }}{% endfor %}</p>
    </section>
  </form>
</main>
<script>
  const folios = {{ dict(folios)|tojson }};
  const folio = document.getElementById("folio"), mail = document.getElementById("mailing_address");
  let autofilled = !mail.value;
  mail.addEventListener("input", () => { autofilled = false; });
  folio.addEventListener("input", () => {
    if (autofilled && folios[folio.value]) mail.value = folios[folio.value].replace(" (MOCK)", "");
  });
  // Read the notice as soon as a file is chosen; the button stays as a manual retry.
  const trimFile = document.getElementById("trim_file"), readBtn = document.getElementById("read_notice");
  trimFile.addEventListener("change", () => { if (trimFile.files.length) readBtn.click(); });
  readBtn.form.addEventListener("submit", (e) => {
    if (e.submitter === readBtn) {
      document.getElementById("reading").hidden = false;
      readBtn.disabled = true;
    }
  });
  function addRepair() {
    const rows = document.getElementById("repairs"), row = rows.firstElementChild.cloneNode(true);
    row.querySelectorAll("input").forEach(i => i.value = "");
    rows.appendChild(row);
  }
  function removeRepair(btn) {
    const rows = document.getElementById("repairs");
    if (rows.children.length > 1) btn.parentElement.remove();
    else btn.parentElement.querySelectorAll("input").forEach(i => i.value = "");
  }
</script>
</body>
</html>
